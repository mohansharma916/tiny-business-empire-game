; Engine configuration file.
; Godot 4 project settings for Tiny Business Empire.
; Opening the project in the Godot editor may update the version string below; that's expected.

config_version=5

[application]

config/name="Tiny Business Empire"
config/description="Idle tycoon: turn a chai stall into a business empire."
config/features=PackedStringArray("4.4", "GL Compatibility")
run/main_scene="res://scenes/boot.tscn"
run/low_processor_mode=false
config/quit_on_go_back=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
